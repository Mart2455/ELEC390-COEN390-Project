<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/llGroceryItem"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Red Vertical Notebook Margin Line (Lighter Red) -->
        <View
            android:id="@+id/vNotebookRedLine"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:background="#F28B82"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/dark_green"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cbItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/dark_green"
            android:scaleX="0.8"
            android:scaleY="0.8"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etGroceryInput"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:textCursorDrawable="@null"
            android:textColor="@color/black"
            android:hint=""
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:fontFamily="@font/quicksand"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand"
            android:text="Milk"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvExpiryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand"
            android:text=" - Expiry 12/12/2024"
            android:textSize="12sp"
            android:textColor="@color/medium_grey"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Horizontal Notebook Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />
</LinearLayout>
