<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar: Back & Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackSetup"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/back_btn"
                app:tint="#2A2A2A"
                android:scaleType="fitCenter"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvTitleSetup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Edit Device"
                android:textColor="#2A2A2A"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand" />
        </LinearLayout>

        <!-- Icon Card Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="14dp">

            <FrameLayout
                android:id="@+id/viewIconBox"
                android:layout_width="125dp"
                android:layout_height="125dp"
                android:background="@drawable/bg_dialog_rounded"
                android:backgroundTint="@color/white"
                android:padding="8dp"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSetupIcon"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:layout_gravity="center"
                    android:src="@drawable/fridge_icon"
                    android:contentDescription="Device Icon" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEditIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Edit Icon"
                android:textColor="@color/dark_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Form Info Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/white"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Device Name Label -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvDeviceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Device"
                    android:textColor="#2A2A2A"
                    android:textSize="16sp"
                    android:fontFamily="@font/quicksand" />

                <TextView
                    android:id="@+id/tvDeviceNameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Device 1"
                    android:textColor="#2A2A2A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/quicksand" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginVertical="6dp" />

            <!-- Select what to track Header -->
            <TextView
                android:id="@+id/tvSelectTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select what to track:"
                android:textColor="#888888"
                android:textSize="14sp"
                android:fontFamily="@font/quicksand"
                android:layout_marginBottom="10dp" />

            <!-- Tracking Toggle Buttons -->
            <LinearLayout
                android:id="@+id/layoutTrackOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnFreshness"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_pill_selectable"
                    android:text="Freshness"
                    android:fontFamily="@font/quicksand"
                    android:textStyle="bold"
                    android:textColor="@color/pill_text_color"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnMoisture"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_pill_selectable"
                    android:text="Moisture"
                    android:fontFamily="@font/quicksand"
                    android:textStyle="bold"
                    android:textColor="@color/pill_text_color"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnFermentation"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_pill_selectable"
                    android:text="Fermentation"
                    android:fontFamily="@font/quicksand"
                    android:textStyle="bold"
                    android:textColor="@color/pill_text_color"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Save Changes Button -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/dark_green"
            android:text="Save Changes"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="@font/quicksand"
            android:layout_marginBottom="8dp" />

        <!-- Remove Device Button -->
        <Button
            android:id="@+id/btnRemoveDevice"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="#FFF0F0"
            android:text="Remove Device"
            android:textColor="#C0392B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="@font/quicksand" />
    </LinearLayout>
</ScrollView>
