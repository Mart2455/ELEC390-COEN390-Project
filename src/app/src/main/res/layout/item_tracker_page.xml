<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:background="@drawable/bg_item_card"
        android:elevation="2.5dp"
        android:outlineAmbientShadowColor="#20000000"
        android:outlineSpotShadowColor="#15000000">

        <TextView
            android:id="@+id/tvTrackingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand"
            android:text="Tracking: Moisture"
            android:textColor="#2A2A2A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackingSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/quicksand"
            android:text="Humidity levels"
            android:textColor="#888888"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/quicksand"
            android:text="Status"
            android:textColor="#7EC8E3"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Icon -->
            <ImageView
                android:id="@+id/ivTrackerIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/moisture_icon"
                app:tint="#7EC8E3"
                android:contentDescription="Tracker Icon" />

            <!-- Sensor Value -->
            <TextView
                android:id="@+id/tvSensorValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/quicksand"
                android:text="30% (low)"
                android:textColor="#7EC8E3"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
