<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Green Banner -->
    <View
        android:id="@+id/topBanner"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_alignParentTop="true"
        android:background="@color/pastel_green" />

    <!-- Bottom Green Banner -->
    <View
        android:id="@+id/bottomBanner"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@color/pastel_green" />

    <!-- Main Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBanner"
        android:layout_below="@id/topBanner"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- "Welcome" -->

        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/shrikhand"
            android:text="Welcome"
            android:textColor="@color/dark_charcoal"
            android:textSize="52sp" />

        <!-- "YES!" Button -->
        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:fontFamily="@font/quicksand"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Are you ready to add your\nfirst device?"
            android:textColor="@color/medium_grey"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnYes"
            android:layout_width="160dp"
            android:layout_height="75dp"
            android:layout_marginTop="60dp"
            android:background="@drawable/bg_blob_button"
            app:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="YES!"
            android:fontFamily="@font/quicksand"
            android:textStyle="bold"
            android:textColor="@color/dark_green"
            android:textSize="30sp" />

        <!-- Apples  -->
        <ImageView

            android:id="@+id/ivApples"
            android:layout_width="210dp"
            android:layout_height="130dp"
            android:layout_marginTop="40dp"
            android:contentDescription="Happy Apples Graphic"
            android:scaleType="fitCenter"
            android:src="@drawable/happy_apples"
            android:translationY="40dp"
            />

    </LinearLayout>

</RelativeLayout>