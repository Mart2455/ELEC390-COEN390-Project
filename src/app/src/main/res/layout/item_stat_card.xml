<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_item_card"
    android:elevation="2.5dp"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="#20000000"
    android:outlineSpotShadowColor="#15000000"
    android:padding="12dp">

    <!-- Top Row: Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivTrackerIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Stat Icon"
            android:src="@drawable/moisture_icon"
            app:tint="#7EC8E3" />

        <TextView
            android:id="@+id/tvTrackingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/quicksand"
            android:text="Moisture"
            android:textColor="#2A2A2A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTrackingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/quicksand"
        android:text="Humidity levels"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvStatusLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/quicksand"
        android:text="Connecting..."
        android:textColor="#7EC8E3"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSensorValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/quicksand"
        android:text="No readings available"
        android:textColor="#2A2A2A"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
