<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Green Banner -->
    <RelativeLayout
        android:id="@+id/topBannerGuide"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_alignParentTop="true"
        android:background="@color/pastel_green"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp">

        <ImageButton
            android:id="@+id/btnBackUserGuide"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back Button"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/back_btn"
            app:tint="@color/dark_charcoal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/shrikhand"
                android:text="User Guide"
                android:textColor="@color/dark_charcoal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand"
                android:text="App Navigation &amp; Feature Manual"
                android:textColor="@color/medium_grey"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Scrollable Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBannerGuide"
        android:layout_above="@+id/bottomNavUserGuide"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Container Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_all"
                android:backgroundTint="#F2EFE9"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Search Input Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_item_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search Icon"
                        android:src="@drawable/ic_search_24"
                        app:tint="#888888" />

                    <EditText
                        android:id="@+id/etGuideSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/quicksand"
                        android:hint="Search topics (e.g. sensors, alerts, expiry)..."
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#2A2A2A"
                        android:textColorHint="#888888"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnClearGuideSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear Search"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="#888888" />
                </LinearLayout>

                <!-- Category Filter Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/containerFilterChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_pill_dark"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="🌟 All"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterNav"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_pill_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="🧭 Navigation"
                            android:textColor="#4A4A4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterSensors"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_pill_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="🌡️ Sensors"
                            android:textColor="#4A4A4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterInventory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_pill_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="🛒 Food Inventory"
                            android:textColor="#4A4A4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_pill_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="🔔 Alerts"
                            android:textColor="#4A4A4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipFilterSetup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_light"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/quicksand"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:text="⚙️ Setup &amp; FAQ"
                            android:textColor="#4A4A4A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Dynamic Container for Guide Topic Cards -->
                <LinearLayout
                    android:id="@+id/containerGuideTopics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- No Results Message -->
                <TextView
                    android:id="@+id/tvGuideNoResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/quicksand"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No matching guide topics found.\nTry searching with different keywords."
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Quick Action Shortcuts Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_item_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/quicksand"
                        android:text="🚀 Quick Shortcuts"
                        android:textColor="#2A2A2A"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/quicksand"
                        android:text="Jump directly to key application features:"
                        android:textColor="#888888"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnShortcutInventory"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_button"
                            android:fontFamily="@font/quicksand"
                            android:text="🛒 Inventory"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/dark_green" />

                        <Button
                            android:id="@+id/btnShortcutDashboard"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_button"
                            android:fontFamily="@font/quicksand"
                            android:text="🧊 Dashboard"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/dark_green" />

                        <Button
                            android:id="@+id/btnShortcutAddDevice"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_button"
                            android:fontFamily="@font/quicksand"
                            android:text="➕ Add Device"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/dark_green" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavUserGuide"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@color/pastel_green"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/navCartGuide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart Tab"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cart_icon"
            app:tint="@color/dark_charcoal" />

        <ImageButton
            android:id="@+id/navFridgeGuide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Fridge Tab"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fridge_icon"
            app:tint="@color/dark_charcoal" />

        <ImageButton
            android:id="@+id/navSettingsGuide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Settings Tab"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_settings_24"
            app:tint="@color/white" />
    </LinearLayout>

</RelativeLayout>
