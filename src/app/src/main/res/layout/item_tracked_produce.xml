<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_item_card"
    android:elevation="2.5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="#20000000"
    android:outlineSpotShadowColor="#15000000"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imgTrackedItemPhoto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_thumb_rounded"
        android:clipToOutline="true"
        android:contentDescription="Item Thumbnail"
        android:scaleType="centerCrop"
        android:src="@drawable/cart_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvTrackedItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/quicksand"
            android:singleLine="true"
            android:text="Granny Smith Apple"
            android:textColor="#2A2A2A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackedItemQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/quicksand"
            android:text="2 pcs"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTrackedItemExpiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/quicksand"
        android:text="May 18, 2026"
        android:textColor="@color/dark_green"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
