<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Green Banner (Fixed 95dp at top edge) -->
    <View
        android:id="@+id/topBannerIcon"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_alignParentTop="true"
        android:background="@color/pastel_green" />

    <ImageButton
        android:id="@+id/btnBackTracker"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="Back"
        android:scaleType="fitCenter"
        android:src="@drawable/back_btn" />

    <TextView
        android:id="@+id/tvTempIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/quicksand"
        android:text="--°C"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Scrollable Middle Content Area (Positioned between Top Banner and Bottom Nav) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollViewTracker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavBarTracker"
        android:layout_below="@id/topBannerIcon"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="90dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded_all"
                android:backgroundTint="#F2EFE9"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header & Device Title -->
                <TextView
                    android:id="@+id/tvYourFridgeTracker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/shrikhand"
                    android:text="Your fridge"
                    android:textColor="#333333"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceNameTracker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/quicksand"
                    android:text="Device 1"
                    android:textColor="#2A2A2A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Device Icon Box -->
                <FrameLayout
                    android:id="@+id/viewIconBoxTracker"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_dialog_rounded"
                    android:backgroundTint="#F9F8F5"
                    android:clipToOutline="true"
                    android:elevation="2.5dp"
                    android:outlineAmbientShadowColor="#20000000"
                    android:outlineSpotShadowColor="#15000000">

                    <ImageView
                        android:id="@+id/ivSelectedIcon"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:contentDescription="Device Selected Icon"
                        android:src="@drawable/fridge_icon" />
                </FrameLayout>

                <!-- Dynamic Stat Grid Container for Enabled Tracking Parameters -->
                <LinearLayout
                    android:id="@+id/layoutStatGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical" />

                <!-- Tracked Items Section Header -->
                <TextView
                    android:id="@+id/tvTrackedItemsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/quicksand"
                    android:text="Tracked Items"
                    android:textColor="#333333"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- RecyclerView for Items Assigned to this Device -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTrackedItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="16dp"
                    tools:listitem="@layout/item_tracked_produce" />

                <TextView
                    android:id="@+id/tvNoTrackedItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:fontFamily="@font/quicksand"
                    android:text="No produce items assigned to this tracker."
                    android:textColor="#888888"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating 3 Dots Options Button -->
    <ImageButton
        android:id="@+id/btnOptionsTracker"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@+id/bottomNavBarTracker"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_circle_button"
        android:contentDescription="Device Options"
        android:elevation="6dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/baseline_more_horiz_24"
        app:tint="@color/white" />

    <!-- OVERLAY: Options Menu (Hidden by default) -->
    <RelativeLayout
        android:id="@+id/overlayOptionsMenuTracker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:elevation="10dp"
        android:visibility="gone">

        <!-- "Edit" pill Button -->
        <Button
            android:id="@+id/btnEditDeviceTracker"
            android:layout_width="160dp"
            android:layout_height="52dp"
            android:layout_above="@+id/btnOverlayCloseTracker"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_button"
            android:fontFamily="@font/quicksand"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="@color/dark_green"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Duplicate options button on the overlay -->
        <ImageButton
            android:id="@+id/btnOverlayCloseTracker"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="114dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Close Tracker Overlay"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_more_horiz_24"
            app:tint="@color/white" />
    </RelativeLayout>

    <!-- Bottom Navigation Bar (Fixed 90dp at bottom) -->
    <LinearLayout
        android:id="@+id/bottomNavBarTracker"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@color/pastel_green"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/navCartTracker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Cart"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cart_icon"
            app:tint="@color/nav_icon_tint" />

        <ImageButton
            android:id="@+id/navFridgeTracker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Fridge"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fridge_icon"
            app:tint="@color/dark_green" />

        <ImageButton
            android:id="@+id/navSettingsTracker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Settings"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_settings_24"
            app:tint="@color/white" />
    </LinearLayout>

</RelativeLayout>
