<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white">

    <!-- Top Green Banner -->
    <View
        android:id="@+id/topBannerIcon"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:background="@color/pastel_green" />

    <ImageButton
        android:id="@+id/btnBackTracker"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/back_btn"
        />

    <TextView
        android:id="@+id/tvTempIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/quicksand"
        android:text="3°C"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Header & Icon Box -->
    <TextView
        android:id="@+id/tvYourFridgeTracker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="130dp"
        android:fontFamily="@font/shrikhand"
        android:text="Your fridge"
        android:textColor="#333333"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeviceNameTracker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvYourFridgeTracker"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/quicksand"
        android:text="Device 1"
        android:textColor="#777777"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/viewIconBoxTracker"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_below="@id/tvDeviceNameTracker"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp"
        android:background="@drawable/bg_rounded_box">

        <ImageView
            android:id="@+id/ivSelectedIcon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:src="@drawable/baseline_add_24" />
    </FrameLayout>


    <!-- Swipeable ViewPager for Trackers -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerTrackers"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_below="@id/viewIconBoxTracker"
        android:layout_marginTop="20dp"
        tools:listitem="@layout/item_tracker_page" />

    <!-- Dots Indicator Container -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/viewPagerTrackers"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <!-- Interactive Step 1: Green Options Button -->
    <ImageButton
        android:id="@+id/btnOptionsTracker"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@+id/bottomNavBarTracker"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/baseline_more_horiz_24"
        app:tint="@color/white"
        android:scaleType="fitCenter"
        android:padding="10dp"/>

    <!-- OVERLAY: Options Menu (Hidden by default) -->
    <RelativeLayout
        android:id="@+id/overlayOptionsMenuTracker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- "Edit" pill Button -->
        <Button
            android:id="@+id/btnEditDeviceTracker"
            android:layout_width="160dp"
            android:layout_height="55dp"
            android:layout_above="@+id/btnOverlayCloseTracker"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_button"
            app:backgroundTint="@null"
            android:fontFamily="@font/quicksand"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="@color/medium_grey"
            android:textSize="16sp" />

        <!-- Duplicate options button on the overlay -->
        <ImageButton
            android:id="@+id/btnOverlayCloseTracker"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="114dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/baseline_more_horiz_24"
        app:tint="@color/white"
        android:scaleType="fitCenter"
        android:padding="10dp" />
    </RelativeLayout>


    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBarTracker"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@color/pastel_green"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/navCartTracker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cart_icon"
            app:tint="@color/nav_icon_tint" />

        <ImageButton
            android:id="@+id/navFridgeTracker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fridge_icon"
            app:tint="@color/nav_icon_tint" />

        <ImageButton
            android:id="@+id/navSettingsTracker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_settings_24"
            app:tint="@color/nav_icon_tint" />
    </LinearLayout>

</RelativeLayout>