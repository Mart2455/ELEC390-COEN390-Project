<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Green Banner -->
    <View
        android:id="@+id/topBannerMain"
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:layout_alignParentTop="true"
        android:background="@color/pastel_green" />

    <ImageButton
        android:id="@+id/btnBackMain"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/back_btn"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTempMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/quicksand"
        android:text="3°C"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_alignParentBottom="true"
        android:background="@color/pastel_green"
        android:orientation="horizontal"
        android:paddingBottom="20dp">

        <ImageButton
            android:id="@+id/navCart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/cart_icon"
            app:tint="@color/nav_icon_tint" />

        <ImageButton
            android:id="@+id/navFridge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fridge_icon"
            app:tint="@color/nav_icon_tint" />

        <ImageButton
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/baseline_settings_24"
            app:tint="@color/nav_icon_tint" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Placeholder for your Box Image -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/empty_fridge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/quicksand"
            android:text="@string/please_connect_your_device"
            android:textColor="@color/medium_grey"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAddedDevices"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBannerMain"
        android:layout_above="@id/bottomNavBar"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/shrikhand"
            android:text="Your fridge"
            android:textColor="#333333"
            android:textSize="26sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Green '+' Button -->
    <ImageButton
        android:id="@+id/btnPlus"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_above="@id/bottomNavBar"
        android:layout_alignParentRight="true"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/baseline_add_24"
        app:tint="@color/white"
        android:scaleType="fitCenter"
        android:padding="10dp"/>

    <!-- OVERLAY: Add Device (Hidden by default) -->
    <RelativeLayout
        android:id="@+id/overlayAddMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:elevation="10dp">

        <!-- "Add device" Pill Button -->
        <Button
            android:id="@+id/btnAddDevice"
            android:layout_width="160dp"
            android:layout_height="55dp"
            android:layout_above="@+id/btnOverlayClose"
            android:layout_alignParentRight="true"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_button"
            app:backgroundTint="@null"
            android:fontFamily="@font/quicksand"
            android:text="Add device"
            android:textAllCaps="false"
            android:textColor="@color/medium_grey"
            android:textSize="16sp" />

        <!-- '+' button on the overlay -->
        <ImageButton
            android:id="@+id/btnOverlayClose"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="114dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/baseline_add_24"
        app:tint="@color/white"
        android:scaleType="fitCenter"
        android:padding="10dp" />
    </RelativeLayout>

</RelativeLayout>