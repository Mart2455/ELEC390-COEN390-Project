<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera Viewfinder (ZXing) -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeScannerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay UI Container -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Close Button (X) -->
        <ImageButton
            android:id="@+id/btnCloseScanner"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_circle_button"
            android:backgroundTint="#80000000"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white"
            android:contentDescription="Close" />

        <!-- Top Toggle Pills: Barcode | Expiration -->
        <LinearLayout
            android:id="@+id/llTogglePills"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="80dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_pill_dark"
            android:padding="4dp">

            <TextView
                android:id="@+id/pillBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:backgroundTint="@color/dark_green"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="||| Barcode"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand" />

            <LinearLayout
                android:id="@+id/pillExpirationLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/ivPillExpirationIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#D0D0D0"
                    android:contentDescription="Expiration Calendar Icon" />

                <TextView
                    android:id="@+id/pillExpiration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiration"
                    android:textColor="#D0D0D0"
                    android:textSize="14sp"
                    android:fontFamily="@font/quicksand" />
            </LinearLayout>
        </LinearLayout>

        <!-- Subtitle: Point at barcode / Point at the date -->
        <TextView
            android:id="@+id/tvScanInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/llTogglePills"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="Point at barcode"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/quicksand"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />

        <!-- Center Product Recognized Card (Barcode Mode) -->
        <LinearLayout
            android:id="@+id/cardProductPreview"
            android:layout_width="280dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            android:layout_marginBottom="120dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="#E62A2A2A"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgProductThumb"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_thumb_rounded"
                android:src="@drawable/cart_icon"
                app:tint="@color/white"
                android:contentDescription="Product Image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/tvProductBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sunny Valley"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/quicksand" />

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pasta Sauce"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp"
                    android:fontFamily="@font/quicksand" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Date Recognized Card (Expiration Mode) -->
        <LinearLayout
            android:id="@+id/cardDatePreview"
            android:layout_width="220dp"
            android:layout_height="70dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="200dp"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="#E62A2A2A"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_today"
                app:tint="@color/white"
                android:layout_marginEnd="10dp"
                android:contentDescription="Calendar Icon" />

            <TextView
                android:id="@+id/tvScannedDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apr 30, 2027"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/quicksand" />
        </LinearLayout>

        <!-- Center Date Target Reticle Box (Expiration Mode) -->
        <View
            android:id="@+id/boxDateReticle"
            android:layout_width="280dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_grocery_content"
            android:backgroundTint="#1AFFFFFF"
            android:visibility="gone" />

        <!-- Bottom Next Button -->
        <Button
            android:id="@+id/btnNextScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="36dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/dark_green"
            android:text="Next"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/quicksand"
            android:visibility="gone" />
    </RelativeLayout>
</RelativeLayout>
