<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_item_card"
    android:elevation="2.5dp"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="#20000000"
    android:outlineSpotShadowColor="#15000000">

    <!-- Card Header (Click to expand/collapse) -->
    <LinearLayout
        android:id="@+id/layoutTopicHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/frameTopicIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_thumb_rounded"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/ivTopicIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Topic Icon"
                android:src="@drawable/fridge_icon"
                app:tint="@color/dark_green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvTopicTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/quicksand"
                android:text="Topic Title"
                android:textColor="#2A2A2A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTopicCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/quicksand"
                android:text="Category Name"
                android:textColor="@color/dark_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivExpandChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Expand Arrow"
            android:src="@drawable/ic_expand_more_24"
            app:tint="#888888" />
    </LinearLayout>

    <!-- Card Expandable Content -->
    <LinearLayout
        android:id="@+id/layoutTopicBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <!-- Summary Description -->
        <TextView
            android:id="@+id/tvTopicDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quicksand"
            android:lineSpacingExtra="3dp"
            android:text="Detailed topic explanation..."
            android:textColor="#333333"
            android:textSize="13sp" />

        <!-- Bullet Points / Steps Container -->
        <LinearLayout
            android:id="@+id/containerTopicBullets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Pro Tip Box -->
        <LinearLayout
            android:id="@+id/layoutTopicTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_box"
            android:backgroundTint="#E8F5E9"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/quicksand"
                android:text="💡"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTopicTipText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand"
                android:lineSpacingExtra="2dp"
                android:text="Pro Tip text goes here."
                android:textColor="#1B5E20"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
