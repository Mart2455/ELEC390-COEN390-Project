<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="12dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_item_card"
    android:elevation="2.5dp"
    android:outlineAmbientShadowColor="#20000000"
    android:outlineSpotShadowColor="#15000000">

    <!-- 1. Device Name on Top -->
    <TextView
        android:id="@+id/tvDeviceNameMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Device 1"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2A2A2A"
        android:fontFamily="@font/quicksand"
        android:layout_marginBottom="8dp" />

    <!-- 2. Big Icon Box in Middle -->
    <FrameLayout
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/bg_thumb_rounded"
        android:clipToOutline="true"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ivDeviceIconMain"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/fridge_icon"
            android:contentDescription="Device Icon" />
    </FrameLayout>

    <!-- 3. Stats & Tracking Info under Icon -->
    <TextView
        android:id="@+id/tvTrackingMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tracking: Moisture"
        android:textSize="12sp"
        android:textColor="#888888"
        android:fontFamily="@font/quicksand"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvConnectionStatusMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Connected"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/dark_green"
        android:fontFamily="@font/quicksand"
        android:gravity="center" />
</LinearLayout>
