<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_item_card"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:elevation="2.5dp"
    android:outlineAmbientShadowColor="#20000000"
    android:outlineSpotShadowColor="#15000000">

    <!-- Selection CheckBox (Hidden by default, shown in selection mode) -->
    <CheckBox
        android:id="@+id/cbSelectOwned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/dark_green"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:focusable="false"
        android:clickable="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgOwnedRowPhoto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_thumb_rounded"
        android:clipToOutline="true"
        android:src="@drawable/cart_icon"
        android:contentDescription="Item Thumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvOwnedRowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chicken Breast"
            android:textColor="#2A2A2A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/quicksand" />

        <TextView
            android:id="@+id/tvOwnedRowExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Oct 13, 2026"
            android:textColor="#888888"
            android:textSize="11sp"
            android:fontFamily="@font/quicksand" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOwnedRowQty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2 pcs"
        android:textColor="#2A2A2A"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/quicksand" />
</LinearLayout>
