<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog_rounded">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/fridge_icon"
        app:tint="@color/dark_green"
        android:layout_marginBottom="10dp"
        android:contentDescription="Fridge Friends Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fridge Friends"
        android:textColor="#333333"
        android:textSize="22sp"
        android:fontFamily="@font/shrikhand"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0.0 (Build 2026)"
        android:textColor="#777777"
        android:textSize="13sp"
        android:fontFamily="@font/quicksand"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Smart fridge monitoring and grocery inventory assistant. Built for ELEC390 / COEN390 Capstone Project."
        android:textColor="#2A2A2A"
        android:textSize="13sp"
        android:gravity="center"
        android:fontFamily="@font/quicksand"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btnAboutClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/dark_green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/quicksand"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
