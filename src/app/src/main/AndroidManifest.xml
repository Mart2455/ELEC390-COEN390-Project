<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for receiving sensor data from the ESP32 via WiFi[cite: 8] -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Welcome Screen -->
        <activity
            android:name=".view.WelcomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <!-- This tells Android to present this activity first when the application starts[cite: 9] -->
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Dashboard Screen -->
        <activity
            android:name=".view.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Add Device Menu -->
        <activity
            android:name=".view.AddDeviceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Fridge Setup Menu -->
        <activity
            android:name=".view.FridgeSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Icon Selection Screen -->
        <activity
            android:name=".view.IconSelectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Swipeable Device Tracker Screen -->
        <activity
            android:name=".view.DeviceTrackerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>